# Database Connection (Supabase PostgreSQL / Local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/protected_money_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/protected_money_dev?schema=public"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://demo-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="demo-anon-key-placeholder"
SUPABASE_SERVICE_ROLE_KEY="demo-service-role-key-placeholder"

# Environment & Demo Guards
NODE_ENV="development"
ENABLE_DEMO_PERSONAS="true"

# Cron Authentication
CRON_SECRET="demo-cron-secret-change-in-production"

# PayPal Sandbox Configuration (Reserved for Milestone 5)
PAYPAL_SANDBOX_CLIENT_ID="placeholder_client_id"
PAYPAL_SANDBOX_CLIENT_SECRET="placeholder_client_secret"
PAYPAL_SANDBOX_MERCHANT_ID="SANDBOX_MERCHANT_DEFAULT"
PAYPAL_SANDBOX_MERCHANT_EMAIL="merchant@demo.local"
PAYPAL_WEBHOOK_ID="placeholder_webhook_id"

